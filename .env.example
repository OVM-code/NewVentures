# Admin login password for /admin
ADMIN_PASSWORD=changeme

# Optional: separate secret for signing session cookies (falls back to ADMIN_PASSWORD if unset)
SESSION_SECRET=

# Local dev: leave unset to use a local SQLite file (local.db).
# Production (Vercel etc.): create a free database at https://turso.tech and set these:
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
